# Copy this file to .env and fill in real values. Never commit .env itself.

# Full service account JSON, as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", "...": "..."}'

# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your_google_sheet_id_here

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
